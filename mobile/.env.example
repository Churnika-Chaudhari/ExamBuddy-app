# Non-secret backend base URL only. Do not put API keys, database URLs,
# JWT secrets, or other credentials in EXPO_PUBLIC_* variables.

# Production / Play Store builds (required, HTTPS):
# EXPO_PUBLIC_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api/v1
#
# Supply that value to EAS instead of committing it:
#   eas env:create --name EXPO_PUBLIC_API_URL --value <your-https-url> --environment production --visibility plaintext

# Local development:
# Leave EXPO_PUBLIC_API_URL unset to auto-detect (emulator, Expo Go LAN host, or web).
# Set both lines only when you intentionally want a specific backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# EXPO_PUBLIC_API_FORCE=true
